{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "menubar",
  "description": "The desktop tray panel reads account summaries and opens existing Orbit pages.",
  "platforms": ["macOS", "windows"],
  "windows": ["menubar"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-bootstrap",
    "allow-refresh-account",
    "allow-read-usage-summary",
    "allow-menubar-control"
  ]
}
