{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orivelle Orbit",
  "version": "0.1.0",
  "identifier": "io.orivelle.orbit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orivelle Orbit",
        "width": 1120,
        "height": 780,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/previews/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "useLocalToolsDir": true
  },
  "plugins": {
    "updater": {
      "pubkey": "ORBIT_RELEASE_UPDATER_PUBLIC_KEY_REQUIRED",
      "endpoints": [],
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
